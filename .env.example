SITE_URL=https://qmaply.com
QMAP_API_URL=https://mapapp.itzeyz.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random secret for webhook auth (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# Hidden admin (/admin). Username without @; comma-separated. Default includes Andrew_257 in code.
TELEGRAM_ADMIN_USERNAMES=Andrew_257
# Optional numeric Telegram user ids (more reliable than username)
TELEGRAM_ADMIN_IDS=
# SQLite file for outreach CRM (default: data/outreach.sqlite)
OUTREACH_DB_PATH=

# One-time webhook setup (replace placeholders):
# curl "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook" \
#   -d "url=${SITE_URL}/api/telegram/webhook" \
#   -d "secret_token=${TELEGRAM_WEBHOOK_SECRET}"
